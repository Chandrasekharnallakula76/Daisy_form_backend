# Reference for Cloud Run runtime settings. Never build secrets into the image.
NODE_ENV=production
HOST=0.0.0.0
# Cloud Run supplies PORT=8080 from the configured container port; do not add it
# separately in the Console. The image has the same default for local use.
STORAGE_BACKEND=postgres
STATIC_DIR=/app/frontend/dist
APP_BASE_PATH=/
TRUST_PROXY_HOPS=1
# Omit CLIENT_ORIGIN on the first deployment to discover its generated URL.
# Then set the canonical HTTPS service origin before acceptance checks.
# Origin only: no application path and no trailing slash.
# CLIENT_ORIGIN=https://YOUR_SERVICE_HOST.run.app
# Existing Cloud SQL instance is private-IP-only. Cloud Run also requires approved
# Direct VPC egress or an existing Serverless VPC Access connector with reachability.
# Network host project: di-if-vpc-p-hopn; use private-ranges-only VPC egress.
# Working-service subnet: di-if-vpc-p-cns-nane1-cloudlab-subnet.
# Confirm its region is northamerica-northeast1 and this service can use it.
# Setting DB_HOST alone does not configure that network access.
DB_HOST=10.64.1.34
DB_PORT=5432
# The image supplies these non-secret defaults for the confirmed direct-IP path.
# TCP still connects to DB_HOST; this name verifies the server certificate.
DB_SSL_MODE=verify-full
DB_SSL_SERVERNAME=0ede6ea68d67.1rm5nct1ov6wn.northamerica-northeast1.sql-psa.goog
# Optional trusted CA override. Omit to use the public regional CA bundled in src/certs/.
# DB_SSL_CA_PATH=/private/path/to/trusted-ca.crt
DB_NAME=daisy_gci_event_form
# Existing PostgreSQL user; retain its application database grants.
DB_USER=daisy-gci-event-form
# Set as a runtime Secret Manager reference where available; do not fill here.
DB_PASSWORD=
