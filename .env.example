# Local development keeps the existing durable SQLite file.
NODE_ENV=development
HOST=127.0.0.1
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
STORAGE_BACKEND=sqlite
DATABASE_PATH=./data/inquiries.sqlite

# Cloud Run: use NODE_ENV=production and STORAGE_BACKEND=postgres, remove HOST
# to bind 0.0.0.0, and use the PORT injected by Cloud Run (8080 in the image).
# PostgreSQL is mandatory in production; no local-file fallback is allowed.
# Direct TCP to the confirmed private-IP Cloud SQL instance requires verified TLS.
# The Cloud Run image supplies DB_SSL_MODE and DB_SSL_SERVERNAME as defaults.
# DB_HOST=10.64.1.34
# DB_PORT=5432
# DB_SSL_MODE=verify-full
# DB_SSL_SERVERNAME=0ede6ea68d67.1rm5nct1ov6wn.northamerica-northeast1.sql-psa.goog
# Optional trusted CA override; otherwise use the bundled public regional CA.
# DB_SSL_CA_PATH=/private/path/to/trusted-ca.crt
# DB_NAME=daisy_gci_event_form
# DB_USER=daisy-gci-event-form
# DB_PASSWORD=<provide through Secret Manager, never put it in source control>
# For local PostgreSQL or an approved managed socket/proxy that handles transport,
# use DB_SSL_MODE=disable. With no DB_SSL_MODE, source execution preserves the
# existing PostgreSQL connection behavior; set a mode explicitly for deployment.
# CLIENT_ORIGIN=https://YOUR-SERVICE.run.app
# STATIC_DIR=/app/frontend/dist
# APP_BASE_PATH=/
# TRUST_PROXY_HOPS=1
# Cloud Run defaults to trusting the rightmost forwarded address only. Increase
# this count only when DevOps has verified additional trusted proxy hops.
